# Backend
ECHOSAFE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ECHOSAFE_MODEL_CHECKPOINT=
ECHOSAFE_HISTORY_FILE=backend/data/history.json

# Optional MongoDB. Leave URI empty to use local JSON history.
ECHOSAFE_MONGODB_URI=
ECHOSAFE_MONGO_DB=echosafe

# Optional experiment result artifacts
ECHOSAFE_EXPERIMENTS_FILE=ml/experiments/experiments.json
ECHOSAFE_PLOTS_FILE=ml/experiments/plots.json
